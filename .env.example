# Copy to .env — secrets via environment only. App runs fully without optional keys.
# Render names first (JWT_SECRET/DATABASE_URL/FRONTEND_ORIGIN/ADMIN_*/DEMO_*),
# MWAMBA_* kept as local aliases.
JWT_SECRET=change-me-to-32-plus-random-chars-minimum-length!!
MWAMBA_SECRET_KEY=change-me-to-32-plus-random-chars-minimum-length!!
MWAMBA_DB_URL=sqlite+aiosqlite:///./storage/mwamba.db
DATABASE_URL=
MWAMBA_STORAGE_DIR=./storage
MWAMBA_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_ORIGIN=
ADMIN_EMAIL=admin@mwamba.local
ADMIN_PASSWORD=Mwamba123!
MWAMBA_SEED_ADMIN_EMAIL=admin@mwamba.local
MWAMBA_SEED_ADMIN_PASSWORD=Mwamba123!
DEMO_USER_EMAIL=demo@mwamba.local
DEMO_USER_PASSWORD=Demo12345!
# Optional: Celery/Redis (if set, worker path activates; else in-process BackgroundTasks)
REDIS_URL=
# Optional: LLM extraction for scanned reports (app works fully without it)
OPENAI_API_KEY=
LLM_EXTRACTION_ENABLED=false
# Optional: Mindat connector (off by default; respects ToS, manual import otherwise)
MINDAT_API_KEY=
# Optional object storage (local filesystem used when unset)
S3_ENDPOINT_URL=
S3_BUCKET=mwamba
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Upload / job limits
MWAMBA_MAX_UPLOAD_MB=100
MAX_UPLOAD_MB=
MWAMBA_MAX_GRID_CELLS=2500000
MWAMBA_RUN_TIMEOUT_S=240
# Demo hosting: analyst demo account (can run in demo projects, cannot reach Admin).
# Other viewers stay read-only when DEMO_MODE=true. Ephemeral free tier shows a banner.
DEMO_MODE=false
